include "common.fbs";

namespace maestro.fbs;

// Which search a node runs. `VANILLA` reproduces `PathFinder` and
// `WalkNodeEvaluator` decision for decision; any other entry is an
// alternative measured against it. A node reports its own in `Hello`, so a
// fleet is uniform and the controller attributes results to the search that
// produced them.
enum Pathfinder : ubyte {
  VANILLA
}

// At-least-once and idempotent, keyed by `request_id`. Carries exactly the
// inputs of `PathFinder.findPath` that vary per call: `start` is the node
// `WalkNodeEvaluator.getStart` resolved on the server (it reads live entity
// state), `reach_range` is the Manhattan distance that counts as arrival, and
// `max_path_length` and `max_visited_nodes` (already multiplied) bound the
// search. `max_fall_distance` is `Mob.getMaxFallDistance`, which reads the
// mob's target, health and the difficulty, so it varies from call to call.
// Everything else about the mob comes from its `MobClass`.
//
// The node never sees the mob's exact position. The two evaluator branches
// that read it, the collision sweep off a fence or closed door and the check
// for standing on a rail, use `start` in its place.
//
// Tracing carries nothing. A request's trace id is `(run, mix(request_id))`
// and its span id is `request_id`, where `run` arrives with the
// `RegionAssignment` and `mix` is the splitmix64 finalizer
//   z ^= z >> 30; z *= 0xbf58476d1ce4e5b9;
//   z ^= z >> 27; z *= 0x94d049bb133111eb;
//   z ^= z >> 31;
// so both sides name one trace and ratio sampling still sees random bits.
table PathRequest {
  request_id:ulong;
  class_id:ushort;
  start:Vec3s;
  target:Vec3s;
  reach_range:ubyte;
  max_path_length:float;
  max_visited_nodes:ushort;
  max_fall_distance:ushort;
}

// Requests ride UDP, one frame per datagram, so a batch is bounded by the
// datagram size and a tick's requests may span several.
table PathRequestBatch {
  requests:[PathRequest];
}

// One node of a Minecraft `Path`. `type` is the resolved `PathType`, which
// the navigation reads while following the path.
struct PathNode {
  pos:Vec3s;
  type:PathType;
}

// Empty `nodes` means no path was found. `reached` mirrors `Path.reached`.
// `cost` is the malus-weighted A* cost of the end node. `world_sequence` is
// the stream position the node actually answered against.
table PathResponse {
  request_id:ulong;
  reached:bool;
  nodes:[PathNode];
  cost:float;
  world_sequence:ulong;
}
