include "common.fbs";

namespace maestro.fbs;

// Which search a node runs. `VANILLA` reproduces `PathFinder` and
// `WalkNodeEvaluator` decision for decision. Any other entry is an
// alternative compared against it. A node reports its search in `Hello`, so
// the whole fleet runs one search and the controller knows which search
// produced each result.
enum Pathfinder : ubyte {
  VANILLA
}

// At-least-once and idempotent, keyed by `request_id`. Holds only the inputs
// of `PathFinder.findPath` that vary per call. `start` is the node that
// `WalkNodeEvaluator.getStart` resolved on the server (it reads live entity
// state). `reach_range` is the Manhattan distance that counts as arrival.
// `max_path_length` and `max_visited_nodes` (already multiplied) bound the
// search. `max_fall_distance` is `Mob.getMaxFallDistance`, which depends on
// the mob's target, health and the difficulty, so it varies per call.
// Everything else about the mob comes from its `MobClass`.
//
// The node never receives the mob's exact position. The two evaluator
// branches that read it, the collision sweep off a fence or closed door and
// the rail check, use `start` instead.
//
// There are no tracing fields. A request's trace id is `(run, mix(request_id))`
// and its span id is `request_id`, where `run` comes from the
// `RegionAssignment` and `mix` is the splitmix64 finalizer
//   z ^= z >> 30; z *= 0xbf58476d1ce4e5b9;
//   z ^= z >> 27; z *= 0x94d049bb133111eb;
//   z ^= z >> 31;
// so both sides derive the same trace id, and ratio sampling still sees random
// bits.
table PathRequest {
  request_id:ulong;
  class_id:ushort;
  start:Vec3s;
  target:Vec3s;
  reach_range:ubyte;
  max_path_length:float;
  max_visited_nodes:ushort;
  max_fall_distance:ushort;
}

// Requests use UDP, one frame per datagram, so a batch is limited by the
// datagram size and a tick's requests may need several.
table PathRequestBatch {
  requests:[PathRequest];
}

// Requests the controller no longer wants, because their mobs asked again,
// stopped or left. Best effort, like every request frame. A node drops such a
// request if it has not started it, and ignores a copy that arrives later. A
// dropped request is never answered.
table PathCancel {
  request_ids:[ulong];
}

// One node of a Minecraft `Path`. `type` is the resolved `PathType`, which
// the navigation reads while following the path.
struct PathNode {
  pos:Vec3s;
  type:PathType;
}

// Empty `nodes` means no path was found. `reached` mirrors `Path.reached`.
// `cost` is the malus-weighted A* cost of the end node. `world_sequence` is
// the stream position the node actually answered against.
table PathResponse {
  request_id:ulong;
  reached:bool;
  nodes:[PathNode];
  cost:float;
  world_sequence:ulong;
}

// The request named a `class_id` the node has not received. A profile is sent
// on the control channel a tick before any request that uses it, but that
// channel is TCP, and a retransmit can delay it for several ticks while
// requests still arrive over UDP. Replying immediately lets the controller
// drop the request instead of waiting for a timeout.
table UnknownProfile {
  request_id:ulong;
  class_id:ushort;
}
