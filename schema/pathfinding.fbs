include "common.fbs";

namespace maestro.fbs;

// Which search a node runs, reported in `Hello`. `VANILLA` ports `PathFinder`
// and `WalkNodeEvaluator` decision for decision; other entries are
// alternatives compared against it.
enum Pathfinder : ubyte {
  VANILLA
}

// At-least-once and idempotent, keyed by `request_id`. Holds only the
// `PathFinder.findPath` inputs that vary per call; the rest comes from the
// `MobClass`. `start` is the node `WalkNodeEvaluator.getStart` resolved on the
// server. `reach_range` is the Manhattan distance that counts as arrival.
// `max_path_length` and `max_visited_nodes` (already multiplied) bound the
// search. `max_fall_distance` is `Mob.getMaxFallDistance`, which varies with
// target, health and difficulty.
//
// The node never receives the mob's position; the two evaluator branches that
// read it (the collision sweep off a fence or closed door, and the rail check)
// use `start`.
//
// There are no tracing fields. The trace id is `(run, mix(request_id))` and
// the span id is `request_id`, with `run` from the request frame and `mix` the
// splitmix64 finalizer
//   z ^= z >> 30; z *= 0xbf58476d1ce4e5b9;
//   z ^= z >> 27; z *= 0x94d049bb133111eb;
//   z ^= z >> 31;
table PathRequest {
  request_id:ulong;
  class_id:ushort;
  start:Vec3s;
  target:Vec3s;
  reach_range:ubyte;
  max_path_length:float;
  max_visited_nodes:ushort;
  max_fall_distance:ushort;
}

// One frame per datagram, so a tick's requests may need several batches.
table PathRequestBatch {
  requests:[PathRequest];
}

// Requests the controller no longer wants. Best effort: a node drops one it
// has not started, ignores later copies, and never answers it.
table PathCancel {
  request_ids:[ulong];
}

// Asks whether the node serves requests. It waits in the queue and is taken by
// a worker like a request, under the same id rules, but needs no profile and
// runs no search: the answer is a `PathResponse` with no nodes at
// `world_sequence` 0. The frame's `region_id` is 0.
table PathProbe {
  request_id:ulong;
}

// One node of a Minecraft `Path`; `type` is the resolved `PathType`.
struct PathNode {
  pos:Vec3s;
  type:PathType;
}

// Empty `nodes` means no path. `reached` mirrors `Path.reached`. `cost` is the
// malus-weighted A* cost of the end node. `world_sequence` is the stream
// position the answer was computed against. `wait_micros` is how long the
// request waited at the node for a worker, and `search_micros` how long its
// search took, 0 if it did not search; a later copy repeats the bytes, so both
// describe the first.
table PathResponse {
  request_id:ulong;
  reached:bool;
  nodes:[PathNode];
  cost:float;
  world_sequence:ulong;
  wait_micros:uint;
  search_micros:uint;
}

// The request named a `class_id` the node lacks. A TCP retransmit can delay
// the profile past the UDP request; replying lets the controller drop the
// request instead of timing out.
table UnknownProfile {
  request_id:ulong;
  class_id:ushort;
}
