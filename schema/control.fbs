include "common.fbs";
include "world.fbs";
include "mob.fbs";
include "pathfinding.fbs";

namespace maestro.fbs;

// Assigns a square, full-height area (region plus halo; the node cannot tell
// them apart). `run` is the controller process; region ids and sequences only
// mean something within one run. Positions are relative to the area's corner,
// which the node is never told. `size` is a multiple of 16.
// `min_y` and `height` let the node create the area as air before any chunk
// arrives. If `resume` is set, the node keeps its state and deltas continue
// after its reported `last_sequence`; otherwise it drops state and every
// resident chunk is sent again.
// `sequence` is the stream position the assignment stands at, so the next
// frame is `sequence + 1`. A fresh area is air as of `sequence`; a resume
// repeats the node's `last_sequence`. The node refuses, as a frame it cannot
// apply, an assignment whose `run` is not the link's or a fresh one behind the
// sequence it holds.
table RegionAssignment {
  run:ulong;
  region_id:uint;
  size:ushort;
  min_y:int;
  height:ushort;
  resume:bool;
  sequence:ulong;
}

// The controller's first frame on each of a link's two connections. `link`
// counts the controller's connection attempts to the node, pairing the world
// and control connections of one attempt. A `Join` of another run or a later
// attempt replaces the link; one naming the current attempt joins it, once per
// port. The node closes a connection that opens with anything else, names an
// earlier or lost attempt, or has a zero field, leaving the live link alone.
table Join {
  run:ulong;
  link:ulong;
}

// The node's reply to a `Join` on the control connection: its search, the
// region it still holds, that region's controller run, and its last applied
// world sequence. A node with no state (as after a restart) reports 0 for
// `last_sequence`, `run` and `region_id`. Region ids start at 1. The
// controller answers with a `RegionAssignment`.
table Hello {
  run:ulong;
  region_id:uint;
  last_sequence:ulong;
  pathfinder:Pathfinder = VANILLA;
}

// Sent unsolicited on the node's timer. Phi accrual reads arrival intervals on
// the controller's clock, so there is no timestamp.
table Heartbeat {
  queue_depth:uint; // For load management.
}

// One union per channel and direction, so a reader dispatches on one root
// type. World and control are TCP; requests are UDP.
union WorldMsg { WorldDelta, RegionAssignment, ChunkSnapshot, Join }
table WorldFrame { body:WorldMsg; }

// A node drops a frame whose `run` is not its link's, and answers a request
// for a `region_id` it does not hold as if it held no area.
union RequestMsg { PathRequestBatch, PathCancel }
table RequestFrame { body:RequestMsg; run:ulong; region_id:uint; }

// `run` repeats the request's, so a controller drops answers for an earlier
// run.
union ResponseMsg { PathResponse, UnknownProfile }
table ResponseFrame { body:ResponseMsg; run:ulong; }

union ControlMsg { MobClass, Join }
table ControlFrame { body:ControlMsg; }

union ControlReplyMsg { Hello, Heartbeat }
table ControlReplyFrame { body:ControlReplyMsg; }

// flatc allows one root_type; other frames are read with `GetRoot<T>()`.
root_type WorldFrame;
