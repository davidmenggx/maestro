include "common.fbs";

namespace maestro.fbs;

// `WalkNodeEvaluator` profile named by `class_id` in each request. These inputs
// change per mob at runtime, so profiles are interned by content and
// `class_id` names content, not a mob type. A node gets a profile the first
// time a request names one it lacks.
// `width` and `height` are positive and give a footprint of
// `floor(width + 1)^2 * floor(height + 1)` cells (as `NodeEvaluator.prepare`)
// of at most 512; larger searches stay on the server. `max_up_step` is in
// [0, 16].
table MobClass {
  class_id:ushort;
  width:float;
  height:float;
  malus:[float];             // Effective malus per `PathType` ordinal
  max_up_step:float;         // Step-up height without jumping
  can_pass_doors:bool;
  can_open_doors:bool;
  can_float:bool;
  can_walk_over_fences:bool;
}
