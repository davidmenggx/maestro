include "common.fbs";

namespace maestro.fbs;

// Land-mob (`WalkNodeEvaluator`) pathfinding profile, referenced by `class_id`
// in each request. These inputs are live per-mob state, so a profile is
// interned by content and `class_id` names that content, not a mob type. A
// node is sent a profile the first time a request names one it does not hold.
table MobClass {
  class_id:ushort;
  width:float;
  height:float;
  malus:[float];             // Effective malus per `PathType` ordinal
  max_up_step:float;         // Step-up height without jumping
  can_pass_doors:bool;
  can_open_doors:bool;
  can_float:bool;
  can_walk_over_fences:bool;
}
