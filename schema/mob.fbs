include "common.fbs";

namespace maestro.fbs;

// Land-mob (`WalkNodeEvaluator`) pathfinding profile, referenced by `class_id`
// in each request. These inputs change at runtime per mob, so a profile
// is interned by content, and `class_id` names that content, not a mob type. A
// node is sent a profile the first time a request names one it does not hold.
// `width` is in (0, 64], `height` in (0, 256] and `max_up_step` in [0, 16],
// which holds every land mob vanilla can make.
table MobClass {
  class_id:ushort;
  width:float;
  height:float;
  malus:[float];             // Effective malus per `PathType` ordinal
  max_up_step:float;         // Step-up height without jumping
  can_pass_doors:bool;
  can_open_doors:bool;
  can_float:bool;
  can_walk_over_fences:bool;
}
