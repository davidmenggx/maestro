namespace maestro.fbs;

// Test data, never sent: scripts driving one node through its links, with the
// effects expected at each step. The node and the controller's model both
// replay every case. Answers are compared by request id, run and world
// sequence only, since the model does not run A*.
//
// A replay starts with an empty node, no workers, 1000 ms retention of answers
// and cancels, a 1000 ms request wait limit, and the vanilla search. Time
// starts at 0 and moves only with `Advance`.

enum LinkPort : ubyte { World, Control }

enum StepKind : ubyte {
  // A new connection on `port` opening with `frame`. Becomes current unless
  // refused.
  Connect,
  // `frame` on the current connection of `port`.
  Stream,
  // The controller closes the current connection of `port`.
  Disconnect,
  // `frame` as one datagram, from one fixed address.
  Datagram,
  // `millis` pass.
  Advance,
  // Run `count` waiting requests, oldest first, or all if 0. Canceled and
  // expired requests are skipped and not counted.
  Serve,
  // The node's heartbeat timer fires.
  Heartbeat
}

enum EffectKind : ubyte {
  // A `Hello` on the control connection: `run`, `region_id`, and
  // `last_sequence` as `sequence`.
  Hello,
  // A `Heartbeat` on the control connection, with `depth`.
  Heartbeat,
  // A `PathResponse` datagram: `request_id`, the frame's `run`, and
  // `world_sequence` as `sequence`.
  Answer,
  // An `UnknownProfile` datagram: `request_id` and the frame's `run`.
  UnknownProfile,
  // The node dropped its link, once per drop whatever the connection count.
  LinkDropped,
  // The node closed the connection the step opened.
  Refused
}

table Effect {
  kind:EffectKind;
  run:ulong;
  region_id:uint;
  sequence:ulong;
  depth:uint;
  request_id:ulong;
}

// `effects` are the node's replies to the step, in order.
table Step {
  kind:StepKind;
  port:LinkPort;
  frame:[ubyte];
  millis:uint;
  count:uint;
  effects:[Effect];
}

table ConformanceCase {
  name:string;
  steps:[Step];
}

table ConformanceFixture {
  cases:[ConformanceCase];
}

root_type ConformanceFixture;
file_identifier "MCNF";
