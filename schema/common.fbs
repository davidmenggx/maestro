namespace maestro.fbs;

// Mirrors Minecraft's `PathType`; ordinals must match. Indexes cell types and
// the per-mob `malus` table.
//
// Cells carry only values `getPathTypeFromState` can return. The node derives
// the rest: `WALKABLE`, `ON_TOP_OF_POWDER_SNOW`, `ON_TOP_OF_TRAPDOOR`,
// `WATER_BORDER` and the `*_IN_NEIGHBOR` types from neighbors, and
// `WALKABLE_DOOR`, `UNPASSABLE_RAIL` and `BIG_MOBS_CLOSE_TO_DANGER` from the
// mob. `BREACH` is swimming-only and never produced.
enum PathType : ubyte {
  BLOCKED,
  OPEN,
  WALKABLE,
  WALKABLE_DOOR,
  TRAPDOOR,
  POWDER_SNOW,
  ON_TOP_OF_POWDER_SNOW,
  FENCE,
  LAVA,
  WATER,
  WATER_BORDER,
  RAIL,
  UNPASSABLE_RAIL,
  FIRE_IN_NEIGHBOR,
  FIRE,
  DAMAGING_IN_NEIGHBOR,
  DAMAGING,
  DOOR_OPEN,
  DOOR_WOOD_CLOSED,
  DOOR_IRON_CLOSED,
  BREACH,
  LEAVES,
  STICKY_HONEY,
  COCOA,
  DAMAGE_CAUTIOUS,
  ON_TOP_OF_TRAPDOOR,
  BIG_MOBS_CLOSE_TO_DANGER
}

// `x` and `z` are relative to the assigned area's corner, `y` is absolute.
struct Vec3s {
  x:short;
  y:short;
  z:short;
}

struct Vec2i {
  x:int;
  z:int;
}
