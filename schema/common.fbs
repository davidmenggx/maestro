namespace maestro.fbs;

// Mirrors Minecraft's `PathType` enum. Ordinals must match. Cell node types and
// the per-mob `malus` table both index into this.
//
// Cells on the wire only ever carry the values `getPathTypeFromState` can
// return. The rest are derived on the node: `WALKABLE`, `ON_TOP_OF_POWDER_SNOW`,
// `ON_TOP_OF_TRAPDOOR`, `WATER_BORDER` and the two `*_IN_NEIGHBOR` types come
// from the static composition, while `WALKABLE_DOOR`, `UNPASSABLE_RAIL`,
// `BREACH` and `BIG_MOBS_CLOSE_TO_DANGER` depend on the mob.
enum PathType : ubyte {
  BLOCKED,
  OPEN,
  WALKABLE,
  WALKABLE_DOOR,
  TRAPDOOR,
  POWDER_SNOW,
  ON_TOP_OF_POWDER_SNOW,
  FENCE,
  LAVA,
  WATER,
  WATER_BORDER,
  RAIL,
  UNPASSABLE_RAIL,
  FIRE_IN_NEIGHBOR,
  FIRE,
  DAMAGING_IN_NEIGHBOR,
  DAMAGING,
  DOOR_OPEN,
  DOOR_WOOD_CLOSED,
  DOOR_IRON_CLOSED,
  BREACH,
  LEAVES,
  STICKY_HONEY,
  COCOA,
  DAMAGE_CAUTIOUS,
  ON_TOP_OF_TRAPDOOR,
  BIG_MOBS_CLOSE_TO_DANGER
}

// Block position with `x` and `z` relative to the `min_xz` of the node's
// `RegionAssignment` and `y` absolute.
struct Vec3s {
  x:short;
  y:short;
  z:short;
}

struct Vec2i {
  x:int;
  z:int;
}
