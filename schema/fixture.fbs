namespace maestro.fbs;

// One vanilla `PathFinder.findPath` call. `exact` means the node's
// approximations cannot have changed the answer: its stand-in for the mob's
// position gave the same inputs, and every collision and floor query got the
// same answer as in vanilla. Other cases may diverge and are only measured.
//
// The search ran after the first `world_frames` world frames, and the
// response's `world_sequence` is the last of them.
table ParityCase {
  entity:string;       // Minecraft entity type id, for reports
  exact:bool;
  mob_class:[ubyte];   // `ControlFrame` holding the mob's `MobClass`
  request:[ubyte];     // `RequestFrame` holding one `PathRequest`
  response:[ubyte];    // `ResponseFrame` holding vanilla's `PathResponse`
  world_frames:uint;
}

// Test data, never sent: a world and the vanilla searches run on it, recorded
// by `/maestro capture`. Frames are wire payloads.
//
// `world` is the world stream as a node reads it: a `RegionAssignment`, every
// chunk of the area, then `WorldDelta` frames for changes between searches,
// each as `[uint32 little-endian length][payload]`.
table ParityFixture {
  seed:ulong;
  world:[ubyte];
  cases:[ParityCase];
}

root_type ParityFixture;
file_identifier "MPAR";
