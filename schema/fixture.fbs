namespace maestro.fbs;

// Test data, never sent. A world and the searches vanilla ran on it, recorded
// by the dev-only `/maestro capture` command so the node and the controller can
// both replay them. Every frame inside is a payload exactly as the wire
// carries it.

// One vanilla `PathFinder.findPath` call. `exact` is set when the node's
// approximations cannot have changed the answer: the mob stood at the bottom
// centre of its start node, and every collision and floor query the search
// made got the same answer from the node's model of the cells as from
// vanilla. Other cases may diverge by design and are only measured.
table ParityCase {
  entity:string;       // Minecraft entity type id, for reports
  exact:bool;
  mob_class:[ubyte];   // `ControlFrame` holding the mob's `MobClass`
  request:[ubyte];     // `RequestFrame` holding one `PathRequest`
  response:[ubyte];    // `ResponseFrame` holding vanilla's `PathResponse`
}

// `world` is the world stream as a node reads it off its world channel: a
// `RegionAssignment`, then every chunk of the area, each framed as
// `[uint32 little-endian length][payload]`.
table ParityFixture {
  seed:ulong;
  world:[ubyte];
  cases:[ParityCase];
}

root_type ParityFixture;
file_identifier "MPAR";
