include "common.fbs";

namespace maestro.fbs;

// One block: its `PathType` (`getPathTypeFromState`, a pure function of the
// block state) and `floor`, the top of its collision shape in sixteenths,
// read by `getFloorLevel`. `floor` is rounded up; the few shapes off the grid
// (the lily pad at 1.5) move by less than a sixteenth. It is at most 32, as
// the node looks one block below a collision box and the tallest shapes
// (fences, walls) are 24.
// Neighbor- and mob-dependent types are resolved on the node, so a block
// change is exactly one `CellDelta`.
struct CellDelta {
  pos:Vec3s;
  node_type:PathType;
  floor:ubyte;
}

// One frame of the ordered world stream, applied right after `sequence - 1`.
table WorldDelta {
  sequence:ulong;
  cells:[CellDelta];
}

// A run of vertically contiguous cells sharing one `PathType` and `floor`.
struct CellRun {
  length:ushort;
  node_type:PathType;
  floor:ubyte;
}

// Full state of one chunk at `sequence`, run-length encoded. Empty
// `run_counts` means the chunk is not resident on the server and reads as air,
// as in vanilla's `PathNavigationRegion`. A node starts its area as air and
// fills it as chunks arrive.
//
// `chunk_xz` is the chunk's index within the assigned area, not a world chunk
// coordinate. Columns are indexed `(x - min_x) * 16 + (z - min_z)` from the
// chunk origin. `run_counts` holds each column's run count in that order and
// `runs` the runs of all columns concatenated, so a column's runs start at the
// sum of the earlier counts. Runs go upward from `RegionAssignment.min_y` and
// their lengths sum to its `height`.
table ChunkSnapshot {
  sequence:ulong;
  chunk_xz:Vec2i;
  run_counts:[ushort];
  runs:[CellRun];
}
